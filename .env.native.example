# Copy to a private file; the installer generates a management token if omitted.
# Web login uses a separate administrator password; set/reset with lovestdnsctl password.
# External token access defaults to off; enable in Service Information or lovestdnsctl api on.
# Use the actual host LAN IP to allow access from your network.
WEB_BIND_ADDRESS="127.0.0.1"
WEB_HOST_PORT="8123"
DNS_BIND_ADDRESS="0.0.0.0"
SUITE_DNS_PORT="53"
FORWARD_BIND_ADDRESS="127.0.0.1"
SUITE_INSTANCE_NAME="LovestDNS"
MEMORY_MAX_MB="6144"
CACHE_BUDGET_MB="4096"
TZ="Asia/Shanghai"
CNAUTO="yes"
IPV6="no"
UPDATE="weekly"

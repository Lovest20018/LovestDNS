# Copy to .env and set WEB_UI_TOKEN before starting LovestDNS.
# This is a locally built candidate; no published LovestDNS image is assumed.
PAOPAODNS_SUITE_IMAGE=lovestdns:0.1.0-dev
WEB_UI_TOKEN=
SUITE_READ_TOKEN=
SUITE_INSTANCE_NAME=LovestDNS
TZ=Asia/Shanghai

DNS_BIND_ADDRESS=0.0.0.0
DNS_HOST_PORT=53
# For LAN access, set this to the CT's private IP.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8080

# Defaults preserve existing Compose named volumes. Use absolute directories
# such as /opt/lovestdns/data and /opt/lovestdns/state for a new CT.
DNS_DATA_DIR=suite-dns-data
DNS_STATE_DIR=suite-state

# When migrating, copy the old core's actual settings here.
# For variables not listed in Compose environment, add that mapping too, or
# retain their existing settings in /data/custom_env.ini. .env alone does not
# forward additional variables to the container.
CNAUTO=yes
CNFALL=yes
IPV6=no
CN_TRACKER=yes
USE_MARK_DATA=yes
CUSTOM_FORWARD=
RULES_TTL=0
UPDATE=weekly
